dup 20 /lessequal put
dup 94 /logicaland put
dup 0 /minus put
dup 2 /multiply put
dup 54 /negationslash put
dup 14 /openbullet put
dup 1 /periodcentered put
dup 26 /propersubset put
dup 24 /similar put
dup 91 /union put
dup 56 /universal put
readonly def
currentdict end
currentfile eexec
